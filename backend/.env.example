# backend/.env — copy this file to backend/.env and fill in the real values.
# The real values are NOT in git. The admin (Avner) has them; in production they
# live as environment variables on Render (service "teacher-crm-backend").

# Supabase — project "teacher-crm" (ref ltfguyjrwrcghllvrixu)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=        # Supabase service_role key (bypasses RLS) — admin only

# Anthropic — voice-log transcript analysis (console.anthropic.com)
ANTHROPIC_API_KEY=           # admin only

# Google OAuth — Calendar sync + event creation (Google Cloud client "Teacher-CRM")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=        # admin only
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback   # prod: the Render callback URL

# Optional
WHATSAPP_DRIVER=manual       # 'manual' (click-to-chat, default) or 'cloud_api'
ALLOWED_ORIGINS=http://localhost:5173,https://comforting-pegasus-780af0.netlify.app
PORT=3001
