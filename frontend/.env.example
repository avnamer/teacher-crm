# frontend/.env — copy this file to frontend/.env.local and fill in the real values.
# The real values are NOT in git. The admin (Avner) has them; in production they
# live as environment variables on Netlify (site "comforting-pegasus-780af0").
#
# Note: these ship in the built frontend bundle and are readable by anyone using
# the site — that is expected for the Supabase anon key (its power is limited by
# RLS). Never put a secret (a service key, an API key) in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=      # Supabase anon/public key (safe to expose; not a secret)
VITE_BACKEND_URL=http://localhost:3001   # prod: the Render backend URL
